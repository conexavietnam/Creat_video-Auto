SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="postgres"

CREDENTIAL_KEY="Khóa AES-256: 64 ký tự hex hoặc base64 của 32 byte (bắt buộc khi NODE_ENV=production). Tạo bằng: openssl rand -hex 32"

VAID_APP_ID="Mã app ở id.vaway.vn (bắt buộc ở production)"
VAID_APP_SECRET="Secret app ở id.vaway.vn (bắt buộc ở production, không commit)"
VAID_PUBLIC_URL="https://video.vaway.vn (địa chỉ công khai, dùng dựng callback và kiểm Origin)"
LOGIN_MODE="admin (mặc định: chỉ quản trị viên của app trong id) hoặc user (mọi VAWAY ID)"
# Chạy cục bộ không đặt VAID_APP_ID thì không yêu cầu đăng nhập; production thiếu là từ chối khởi động.

SUPERADMIN_VAIDS="Danh sách VAWAY ID được vào /admin, cách nhau dấu phẩy (production: 1). Không đặt = không ai vào được."

VEO_MODEL="veo-3.1-generate-preview"
KLING_BASE_URL="https://api.klingai.com"
KLING_MODEL="kling-v2-master"
# VEO_MODEL, KLING_MODEL, KLING_BASE_URL chỉ là giá trị dự phòng: model và base URL đặt trong /admin (bảng provider_settings) được ưu tiên.

ENABLE_MOCK_PROVIDER="true"
